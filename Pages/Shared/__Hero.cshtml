<div id="header-carousel" class="carousel slide carousel-fade" data-bs-ride="carousel">
    <div class="carousel-inner">
        <div class="carousel-item active">
            <!-- La imagen se verá totalmente sólida, sin ninguna opacidad o transparencia -->
            <img src="~/landingpage/img/carousel-1.jpg" alt="Image" style="opacity: 1;" />  
            <div class="carousel-caption d-flex flex-column align-items-center justify-content-center">
                <div class="p-3" style="max-width: 900px;">
                    <h5 class="text-white text-uppercase mb-3 animated slideInDown">Implementando Soluciones digitales a tu medida</h5>
                    <h2 class="display-1 text-white mb-md-4 animated zoomIn">Monetizando tus Metas</h2>
                    <a asp-area="" asp-page="/Contact" class="btn btn-outline-light py-md-3 px-md-5 animated slideInRight">Contáctanos</a>
                </div>
            </div>
        </div>
        <div class="carousel-item">
            <img class="w-100" src="~/landingpage/img/carousel-2.jpg" alt="Image">
            <div class="carousel-caption d-flex flex-column align-items-center justify-content-center">
                <div class="p-3" style="max-width: 900px;">
                    <h5 class="text-white text-uppercase mb-3 animated slideInDown">Tecnologías de información para tu negocio o empresa</h5>
                    <h2 class="display-1 text-white mb-md-4 animated zoomIn">Escala tu negocio al siguiente nivel </h2>
                    <a asp-area="" asp-page="/Contact" class="btn btn-primary py-md-3 px-md-5 me-3 animated slideInLeft">Solicita tu Cotización</a>
                </div>
            </div>
        </div>
    </div>
    <button class="carousel-control-prev" type="button" data-bs-target="#header-carousel"
            data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Previous</span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#header-carousel"
            data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Next</span>
    </button>
</div>